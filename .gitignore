# --- Environnements Virtuels ---
.venv/
venv/
env/
bin/
obj/

# --- Artefacts Python ---
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# --- Données et Modèles (Critique) ---
# On ignore tout le contenu, mais on garde les dossiers via un fichier .gitkeep si nécessaire
data/raw/*
data/processed/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# Fichiers de données volumineux spécifiques
*.csv
*.parquet
*.jsonl
*.h5
*.pth
*.pkl
*.onnx
*.weights

# --- Configuration et Secrets ---
.env
.flaskenv
config.local.yaml
secrets.yaml

# --- Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- OS / IDE ---
.vscode/
.idea/
.DS_Store
Thumbs.db